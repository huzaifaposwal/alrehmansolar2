# ============================================================
# AL REHMAN SOLAR — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/alrehman_solar

# --- Backend Security ---
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Admin Defaults (first run) ---
ADMIN_EMAIL=admin@alrehmansolars.com
ADMIN_PASSWORD=ChangeMe@2024!

# --- CORS ---
FRONTEND_URL=http://localhost:3000
PRODUCTION_URL=https://alrehmansolars.com

# --- Email (Optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@alrehmansolars.com
NOTIFICATION_EMAIL=info@alrehmansolars.com

# --- AI Assistant (Optional) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Analytics (Optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# --- Frontend API URL ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- WhatsApp (configured via admin panel, but can override here) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

# --- Environment ---
ENVIRONMENT=development
DEBUG=true
